# Private App access tokens (Settings > Integrations > Private Apps in each portal).
# Required scope on both apps: forms
SOURCE_ACCESS_TOKEN=
DESTINATION_ACCESS_TOKEN=

# Optional - purely informational, written into migration/form-mapping.json
# and log messages. Not required for the migration to run.
SOURCE_PORTAL_ID=
DESTINATION_PORTAL_ID=

# Optional overrides (defaults shown). Use SOURCE_BASE_URL / DESTINATION_BASE_URL
# instead if the two portals live in different HubSpot data-residency regions
# (e.g. https://api-eu1.hubapi.com).
HUBSPOT_BASE_URL=https://api.hubapi.com
SOURCE_BASE_URL=
DESTINATION_BASE_URL=
MAX_RETRIES=5
PAGE_LIMIT=100
MIGRATION_DIR=./migration

# Optional scope-down: if this file exists, ONLY source forms whose name
# (trimmed) appears in it - one name per line - are migrated. Delete/rename
# this env var (or the file) to go back to migrating every source form.
ALLOWED_FORMS_FILE=./allowed-forms.txt

# Optional: prefix applied to every destination form's name. If it needs a
# trailing space, the value MUST be double-quoted in .env - dotenv strips
# trailing whitespace from unquoted values.
# DESTINATION_NAME_PREFIX="Touchmath | "
DESTINATION_NAME_PREFIX=
